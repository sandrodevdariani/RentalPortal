@model UnitFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    var action = isEdit ? "Edit" : "Create";
}
<div class="modal-header">
    <h2 class="modal-title">@(isEdit ? "Edit unit" : "Add unit")</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-action="@action" asp-controller="Units" method="post">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PropertyId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        @if (!string.IsNullOrEmpty(Model.PropertyName))
        {
            <p class="quiet">@Model.PropertyName</p>
        }
        <div class="field">
            <label asp-for="UnitNumber"></label>
            <input asp-for="UnitNumber" class="form-control" />
            <span asp-validation-for="UnitNumber" class="field-error"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-4 field">
                <label asp-for="Bedrooms"></label>
                <input asp-for="Bedrooms" class="form-control" />
                <span asp-validation-for="Bedrooms" class="field-error"></span>
            </div>
            <div class="col-md-8 field">
                <label asp-for="MonthlyRent"></label>
                <input asp-for="MonthlyRent" class="form-control" />
                <span asp-validation-for="MonthlyRent" class="field-error"></span>
            </div>
        </div>
        <div class="field">
            <label asp-for="UnitTypeId"></label>
            <select asp-for="UnitTypeId" asp-items="Model.UnitTypes" class="form-select">
                <option value="">Select a type</option>
            </select>
            <span asp-validation-for="UnitTypeId" class="field-error"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
