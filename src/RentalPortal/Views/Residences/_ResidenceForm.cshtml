@model ResidenceFormViewModel
@{
    var isEdit = Model.Id.HasValue;
    var action = isEdit ? "Edit" : "Create";
}
<div class="modal-header">
    <h2 class="modal-title">@(isEdit ? "Edit residence" : "Add residence")</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-action="@action" asp-controller="Residences" method="post">
    <div class="modal-body">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="ApplicationId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <div class="field">
            <label asp-for="Address"></label>
            <input asp-for="Address" class="form-control" />
            <span asp-validation-for="Address" class="field-error"></span>
        </div>
        <div class="row g-3">
            <div class="col-md-6 field">
                <label asp-for="LandlordName"></label>
                <input asp-for="LandlordName" class="form-control" />
                <span asp-validation-for="LandlordName" class="field-error"></span>
            </div>
            <div class="col-md-6 field">
                <label asp-for="LandlordPhone"></label>
                <input asp-for="LandlordPhone" class="form-control" />
                <span asp-validation-for="LandlordPhone" class="field-error"></span>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6 field">
                <label asp-for="MoveInDate"></label>
                <input asp-for="MoveInDate" class="form-control" />
                <span asp-validation-for="MoveInDate" class="field-error"></span>
            </div>
            <div class="col-md-6 field">
                <label asp-for="MoveOutDate"></label>
                <input asp-for="MoveOutDate" class="form-control" />
                <span asp-validation-for="MoveOutDate" class="field-error"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Save</button>
    </div>
</form>
