@model ReviewFormViewModel
<div class="modal-header">
    <h2 class="modal-title">Review application</h2>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<form asp-action="Review" method="post">
    <div class="modal-body">
        <input type="hidden" asp-for="ApplicationId" />
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <p><strong>@Model.ApplicantName</strong><br /><span class="quiet">@Model.UnitLabel</span></p>
        <fieldset class="field">
            <legend>Outcome</legend>
            <label class="check"><input asp-for="Outcome" type="radio" value="@ReviewOutcome.Approve" /> Approve and issue a twelve-month lease</label>
            <label class="check"><input asp-for="Outcome" type="radio" value="@ReviewOutcome.Return" /> Return for correction</label>
            <label class="check"><input asp-for="Outcome" type="radio" value="@ReviewOutcome.Deny" /> Deny</label>
            <span asp-validation-for="Outcome" class="field-error"></span>
        </fieldset>
        <div class="field">
            <label asp-for="Comment"></label>
            <textarea asp-for="Comment" class="form-control" rows="4" placeholder="Required for Return and Deny"></textarea>
            <span asp-validation-for="Comment" class="field-error"></span>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">Complete review</button>
    </div>
</form>
