@model IReadOnlyList<PropertyListItemViewModel>
<div id="property-list" class="property-list">
    @if (Model.Count == 0)
    {
        <p class="empty">No properties yet.</p>
    }
    @foreach (var property in Model)
    {
        <article class="property-card">
            <header>
                <div>
                    <h2>@property.Name</h2>
                    <p>@property.Address, @property.City, @property.State @property.ZipCode</p>
                </div>
                <div class="card-actions">
                    <button class="btn btn-ghost btn-sm" type="button" data-modal-url="@Url.Action("EditModal", new { id = property.Id })" data-modal-size="modal-lg">Edit</button>
                    <button class="btn btn-ghost btn-sm" type="button" data-modal-url="@Url.Action("DeleteModal", new { id = property.Id })">Remove</button>
                    <button class="btn btn-secondary btn-sm" type="button" data-modal-url="@Url.Action("CreateModal", "Units", new { propertyId = property.Id })">Add unit</button>
                </div>
            </header>
            @await Component.InvokeAsync("PropertyUnits", new { propertyId = property.Id })
        </article>
    }
</div>
