@model IReadOnlyList<PropertyListItemViewModel>
@{
    ViewData["Title"] = "Properties";
}
<section class="page-head">
    <div>
        <p class="kicker">Portfolio</p>
        <h1>Properties &amp; units</h1>
    </div>
    <button class="btn btn-primary" type="button" data-modal-url="@Url.Action("CreateModal")" data-modal-size="modal-lg">Add property</button>
</section>
<partial name="_PropertyList" model="Model" />
